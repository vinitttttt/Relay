# Leave blank to use the same origin (the Vite development proxy handles local API calls).
# Leave blank when the frontend and API share an origin. For separate hosts,
# set this to the HTTPS API origin (for example, https://api.example.com).
VITE_API_BASE_URL=
# Used only by `npm run dev`; the production build does not use Vite's proxy.
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000
