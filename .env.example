# Local development uses SQLite. Relative SQLite paths are resolved from backend/.
DATABASE_URL=sqlite:///./data/relay.db

# For PostgreSQL later, replace DATABASE_URL with a URL such as:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/relay

JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_LOGIN=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_USER_SEARCH=60
RATE_LIMIT_USER_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_WEBSOCKET_MESSAGE=30
RATE_LIMIT_WEBSOCKET_MESSAGE_WINDOW_SECONDS=10
VITE_API_BASE_URL=http://localhost:8000
